# Auto Insurance Agent - 环境变量配置模板
# 复制此文件为 .env 并填入真实值

# ==================== 数据库配置 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=auto_insurance

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== Qdrant 向量数据库 ====================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=insurance_knowledge

# 知识库 Excel 目录（自动导入该目录下所有 .xlsx）
KNOWLEDGE_BASE_DIR=db

# ==================== 第三方 API ====================
OCR_API_KEY=your_ocr_api_key
OCR_API_URL=https://ocr.example.com/api

# 视觉模型 OCR（推荐使用支持图片输入的 OpenAI 兼容接口）
VISION_PROVIDER=siliconflow
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_API_KEY=your_vision_api_key
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 主模型调用失败或字段不足时自动尝试
VISION_FALLBACK_MODEL=Qwen/Qwen3-VL-32B-Instruct
# 多模态模型均失败或字段不足时使用的专用 OCR 兜底模型
VISION_OCR_FALLBACK_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
VISION_TIMEOUT_SECONDS=45

# 保险公司报价 API（未配置有效地址时报价功能不可用）
QUOTE_API_KEY=
QUOTE_API_URL=

UNDERWRITING_API_KEY=your_underwriting_api_key
UNDERWRITING_API_URL=https://underwriting.example.com/api

PAYMENT_API_KEY=your_payment_api_key
PAYMENT_API_URL=https://payment.example.com/api

PROVIDER_API_TIMEOUT_SECONDS=20

HUMAN_SERVICE_WEBHOOK_URL=https://human-service.example.com/webhook

# ==================== 安全配置 ====================
SECRET_KEY=your-secret-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-change-in-production
TOKEN_EXPIRE_MINUTES=60

# ==================== API 鉴权配置 ====================
# AUTH_ENABLED=true 时，所有接口要求提供 API Key（X-API-Key / Authorization: Bearer / ?api_key=）
# 生产环境务必开启并设置强随机 AUTH_API_KEY
AUTH_ENABLED=false
AUTH_API_KEY=

# 双 Token 登录：Access Token 仅保存在前端内存，Refresh Token 使用 HttpOnly Cookie
USER_AUTH_ENABLED=true
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_REFRESH_COOKIE_NAME=cx_refresh_token
# 生产环境使用 HTTPS 时必须设为 true
AUTH_COOKIE_SECURE=false
AUTH_DEMO_LOGIN_ENABLED=true
AUTH_DEMO_CUSTOMER_ID=customer_001
AUTH_DEMO_CUSTOMER_PASSWORD=Customer@123
AUTH_DEMO_AGENT_ID=agent_001
AUTH_DEMO_AGENT_PASSWORD=Agent@123
AUTH_CLIENT_ENCRYPTION_ENABLED=true
AUTH_REQUIRE_CLIENT_ENCRYPTION=true
AUTH_CUSTOMER_REGISTRATION_ENABLED=true
AUTH_AGENT_REGISTRATION_ENABLED=true
# 生产环境必须替换为随机邀请码
AUTH_AGENT_REGISTRATION_CODE=change-me-agent-invite
AUTH_CLIENT_KEY_PATH=.secrets/client_encryption_private.pem

# ==================== LLM 大模型配置 ====================
# 模型提供商: openai / deepseek / azure / ollama
LLM_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4096

# DeepSeek 配置（LLM_PROVIDER=deepseek 时使用）
# 官网: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=4096

# Azure OpenAI 配置（LLM_PROVIDER=azure 时使用）
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_MAX_TOKENS=4096

# 本地大模型 / Ollama 配置（LLM_PROVIDER=ollama 时使用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=4096

# ==================== Embedding 向量模型配置 ====================
# 用于知识库向量检索
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ==================== Rerank 重排序模型（可选） ====================
RERANK_ENABLED=false
RERANK_PROVIDER=openai
RERANK_MODEL=

# ==================== 服务配置 ====================
APP_ENV=development
LOG_LEVEL=INFO

# CORS 允许来源（逗号分隔）。留空回退允许所有来源（此时自动禁用 credentials）。
# 生产环境务必设置为前端域名白名单，如 https://app.example.com
CORS_ORIGINS=

# 内存会话 LRU 上限：超过后淘汰最久未访问的会话（仍可从 Redis/MySQL 回退）
MAX_MEMORY_SESSIONS=5000
# 会话无访问自动超时秒数（默认 24 小时）
SESSION_TTL_SECONDS=86400
